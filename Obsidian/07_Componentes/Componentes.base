filters:
  and:
    - file.hasTag("componente")
    - file.ext == "md"
formulas:
  estado_icon: if(estado == "adquirido" || estado == "✅ RESUELTO", "✅", if(estado == "por investigar" || estado == "investigando", "🔍", if(estado == "❌ FALTANTE" || estado == "pendiente", "❌", "❓")))
properties:
  fabricante:
    displayName: Fabricante
  estado:
    displayName: Estado
views:
  - type: cards
    name: Galería de Componentes
    order:
      - file.name
      - fabricante
      - estado
  - type: table
    name: Inventario Técnico
    groupBy:
      property: estado
      direction: ASC
    order:
      - file.name
      - fabricante
      - estado
